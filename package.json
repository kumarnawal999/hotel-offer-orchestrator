{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Hotel Offer Orchestrator aggregating and deduplicating supplier offers using Node.js, TypeScript, Temporal.io, and Redis.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/server.ts",
    "worker": "ts-node src/temporal/worker.ts",
    "test": "jest --detectOpenHandles --forceExit"
  },
  "keywords": [
    "temporal",
    "redis",
    "express",
    "typescript",
    "hotel-orchestrator"
  ],
  "author": "Triphoria Team",
  "license": "MIT",
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
